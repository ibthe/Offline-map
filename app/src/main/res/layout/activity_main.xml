<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- crosshair: the point shown in the info chip and saved by the add-point button -->
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_crosshair" />

    <!-- TOP: search (56) -> 8 -> results / info chip. Edge margin 16 = same as every other edge. -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_height"
            android:background="@drawable/bg_panel_pill"
            android:elevation="@dimen/elev_3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 16 + 24 icon + 16 = the text starts on the 4dp grid, optically centred in the pill radius -->
            <ImageView
                android:layout_width="@dimen/icon"
                android:layout_height="@dimen/icon"
                android:layout_marginStart="@dimen/space_4"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.Georgia.Title"
                android:textColor="?attr/gmTextPrimary"
                android:textColorHint="?attr/gmHint" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="@dimen/control"
                android:layout_height="@dimen/control"
                android:layout_marginEnd="@dimen/space_1"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="@string/clear"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />
        </LinearLayout>

        <ListView
            android:id="@+id/lvResults"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/bg_panel_list"
            android:clipToOutline="true"
            android:divider="?attr/gmDivider"
            android:dividerHeight="1dp"
            android:elevation="@dimen/elev_3"
            android:outlineProvider="background"
            android:visibility="gone" />

        <!-- info chip shares the left edge of the search pill -->
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/bg_panel"
            android:elevation="@dimen/elev_1"
            android:lineSpacingExtra="2dp"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Georgia.Label"
            android:textColor="?attr/gmTextSecondary" />
    </LinearLayout>

    <!-- RIGHT: one capsule, 48 wide, 16 from the edge, 16 above the dock -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="@dimen/control"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_capsule"
        android:elevation="@dimen/elev_2"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnFit"
            android:layout_width="@dimen/control"
            android:layout_height="@dimen/control"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/btn_fit"
            android:src="@drawable/ic_fit" />

        <View
            android:layout_width="@dimen/space_5"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:background="?attr/gmDivider" />

        <ImageButton
            android:id="@+id/btnLocation"
            android:layout_width="@dimen/control"
            android:layout_height="@dimen/control"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/btn_location"
            android:src="@drawable/ic_my_location"
            app:tint="?attr/gmAccent" />
    </LinearLayout>

    <!-- BOTTOM: dock 64 = 8 + 48 + 8. Gap between the two controls = 8 = dock padding (one rhythm). -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dock_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        android:background="@drawable/bg_dock"
        android:elevation="@dimen/elev_3"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_2">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/control"
            android:layout_height="@dimen/control"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/btn_menu"
            android:src="@drawable/ic_menu" />

        <LinearLayout
            android:id="@+id/btnPoint"
            android:layout_width="0dp"
            android:layout_height="@dimen/control"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:contentDescription="@string/btn_point"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon"
                android:layout_height="@dimen/icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_add_location"
                app:tint="?attr/gmOnAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/btn_point"
                android:textAppearance="@style/TextAppearance.Georgia.Title"
                android:textColor="?attr/gmOnAccent" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="?attr/gmAccent" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_5"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginEnd="@dimen/space_5"
            android:gravity="center"
            android:text="@string/loading"
            android:textAppearance="@style/TextAppearance.Georgia.Body"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</FrameLayout>
