<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_5">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_1"
            android:paddingBottom="@dimen/space_3"
            android:text="Компас"
            android:textAppearance="@style/TextAppearance.Georgia.Headline"
            android:textColor="?attr/gmTextPrimary" />

        <app.georgiamap.CompassView
            android:id="@+id/cmpView"
            android:layout_width="match_parent"
            android:layout_height="320dp" />

        <TextView
            android:id="@+id/cmpMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Georgia.Headline"
            android:textColor="?attr/gmTextPrimary" />

        <TextView
            android:id="@+id/cmpTurn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Georgia.Title" />

        <TextView
            android:id="@+id/cmpSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textAppearance="@style/TextAppearance.Georgia.Label"
            android:textColor="?attr/gmTextSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cmpModeNorth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="Север"
                android:textAppearance="@style/TextAppearance.Georgia.Label" />

            <TextView
                android:id="@+id/cmpModeQibla"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="Кибла"
                android:textAppearance="@style/TextAppearance.Georgia.Label" />

            <TextView
                android:id="@+id/cmpModePoint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="Пункт…"
                android:textAppearance="@style/TextAppearance.Georgia.Label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center_vertical"
            android:minHeight="@dimen/control"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_2">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Поворачивать карту по компасу"
                android:textAppearance="@style/TextAppearance.Georgia.Body"
                android:textColor="?attr/gmTextPrimary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/cmpMapSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
