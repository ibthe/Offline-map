<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_5">

        <TextView
            android:id="@+id/cmpTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_1"
            android:paddingBottom="@dimen/space_3"
            android:text="Компас"
            android:textAppearance="@style/TextAppearance.Georgia.Headline"
            android:textColor="?attr/gmTextPrimary" />

        <!-- PAGE 1: calibration (shown first, and whenever the sensor reports low accuracy) -->
        <LinearLayout
            android:id="@+id/cmpCalibGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <app.georgiamap.CalibView
                android:id="@+id/cmpCalibView"
                android:layout_width="match_parent"
                android:layout_height="180dp" />

            <TextView
                android:id="@+id/cmpCalibStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Georgia.Title"
                android:textColor="?attr/gmAccent" />

            <TextView
                android:id="@+id/cmpCalibSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.Georgia.Body"
                android:textColor="?attr/gmTextPrimary" />

            <TextView
                android:id="@+id/cmpCalibField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:lineSpacingExtra="2dp"
                android:textAppearance="@style/TextAppearance.Georgia.Label"
                android:textColor="?attr/gmTextSecondary" />

            <TextView
                android:id="@+id/cmpCalibDone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_lg"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Готово, к компасу"
                android:textAppearance="@style/TextAppearance.Georgia.Title"
                android:textColor="?attr/gmOnAccent" />
        </LinearLayout>

        <!-- PAGE 2: the compass -->
        <LinearLayout
            android:id="@+id/cmpMainGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <app.georgiamap.CompassView
                android:id="@+id/cmpView"
                android:layout_width="match_parent"
                android:layout_height="320dp" />

            <TextView
                android:id="@+id/cmpMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Georgia.Headline"
                android:textColor="?attr/gmTextPrimary" />

            <TextView
                android:id="@+id/cmpTurn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Georgia.Title" />

            <TextView
                android:id="@+id/cmpSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textAppearance="@style/TextAppearance.Georgia.Label"
                android:textColor="?attr/gmTextSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cmpModeNorth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="Север"
                    android:textAppearance="@style/TextAppearance.Georgia.Label" />

                <TextView
                    android:id="@+id/cmpModeQibla"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="Кибла"
                    android:textAppearance="@style/TextAppearance.Georgia.Label" />

                <TextView
                    android:id="@+id/cmpModePoint"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="Пункт…"
                    android:textAppearance="@style/TextAppearance.Georgia.Label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center_vertical"
                android:minHeight="@dimen/control"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Поворачивать карту по компасу"
                    android:textAppearance="@style/TextAppearance.Georgia.Body"
                    android:textColor="?attr/gmTextPrimary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/cmpMapSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/cmpCalibLink"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control"
                android:background="@drawable/bg_icon_btn"
                android:gravity="center"
                android:text="Калибровка компаса: как это сделать"
                android:textAppearance="@style/TextAppearance.Georgia.Label"
                android:textColor="?attr/gmAccent" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
